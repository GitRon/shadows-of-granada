<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: Georgia, serif; background: white; width: 210mm; margin: 0 auto; padding: 10mm; }
  h1 { font-size: 14pt; text-align: center; color: #3b2a1a; margin-bottom: 1mm; }
  .sub { font-size: 8pt; text-align: center; color: #7a5c3a; margin-bottom: 5mm; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3mm; }
  .card { border-radius: 4px; overflow: hidden; border: 2px solid; background: white; height: 54mm; display: flex; flex-direction: column; page-break-inside: avoid; }
  .hdr { padding: 2mm 3mm; display: flex; align-items: center; gap: 2mm; }
  .hdr .em { font-size: 15pt; line-height: 1; }
  .hdr .nm { color: white; font-weight: bold; font-size: 8.5pt; line-height: 1.2; }
  .action { padding: 2mm 3mm; flex: 1; border-bottom: 1px dashed #c0a880; }
  .action .lbl { font-size: 6.5pt; color: #9a7a5a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1mm; }
  .action .txt { font-size: 7.5pt; color: #1a1a1a; line-height: 1.35; }
  .boost { padding: 2mm 3mm; }
  .boost .lbl { font-size: 6.5pt; color: #9a7a5a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1mm; }
  .boost .sym { font-size: 13pt; line-height: 1; }
  @media print { body { padding: 8mm; } .grid { gap: 2mm; } }
</style>
</head>
<body>
<h1>RECONQUISTA – Aktionskarten</h1>
<p class="sub">24 Karten · 4 pro Symbol · Ausschneiden an den Rändern</p>

<div class="grid">
{%- for c in cards %}
  <div class="card" style="border-color:{{ c.color }}">
    <div class="hdr" style="background:{{ c.color }}">
      <span class="em">{{ c.symbol }}</span>
      <span class="nm">{{ c.name }}</span>
    </div>
    <div class="action">
      <div class="lbl">Aktion</div>
      <div class="txt">{{ c.action }}</div>
    </div>
    <div class="boost">
      <div class="lbl">Verstärkung (unten)</div>
      <div class="sym">{{ c.boost }}</div>
    </div>
  </div>
{%- endfor %}
</div>
</body>
</html>
